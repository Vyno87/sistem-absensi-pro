{
    "name": "sistem-absensi-root",
    "version": "1.0.0",
    "description": "Root orchestrator for Sistem Absensi",
    "private": true,
    "scripts": {
        "start": "concurrently \"npm run start --prefix api\" \"npm run start --prefix frontend\"",
        "build": "npm run build --prefix frontend",
        "install-all": "npm install && npm install --prefix api && npm install --prefix frontend"
    },
    "devDependencies": {
        "concurrently": "^8.2.2"
    },
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "exceljs": "^4.4.0",
        "express": "^5.2.1",
        "express-rate-limit": "^8.2.1",
        "jsonwebtoken": "^9.0.3",
        "mongodb": "^7.0.0",
        "mongoose": "^9.0.2",
        "pdfkit": "^0.17.2"
    }
}