{
    "version": 2,
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.js"
        },
        {
            "source": "/(.*)",
            "destination": "/$1",
            "check": true
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ],
    "crons": [
        {
            "path": "/api/cron/daily-report",
            "schedule": "0 0 * * *"
        },
        {
            "path": "/api/cron/weekly-report",
            "schedule": "30 0 * * 1"
        }
    ]
}