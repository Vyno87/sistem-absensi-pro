{
    "version": 2,
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/index.js"
        },
        {
            "src": "/((?!api/).*)",
            "dest": "/index.html"
        }
    ],
    "crons": [
        {
            "path": "/api/cron/daily-report",
            "schedule": "0 0 * * *"
        },
        {
            "path": "/api/cron/weekly-report",
            "schedule": "30 0 * * 1"
        }
    ]
}